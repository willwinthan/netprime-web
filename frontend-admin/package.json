{
  "name": "frontend-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "dev:local": "VITE_API_BASE_URL=http://localhost:8787/api vite --host 127.0.0.1",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "deploy:staging": "vite build --mode staging && wrangler deploy --env staging"
  },
  "dependencies": {
    "@blocknote/ariakit": "0.56.0",
    "@blocknote/core": "0.56.0",
    "@blocknote/react": "0.56.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-confetti": "^6.4.0",
    "react-dom": "^18.3.1",
    "react-use": "^17.6.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.11",
    "wrangler": "^4.98.0"
  }
}
