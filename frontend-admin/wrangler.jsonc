{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "netprime-frontend",
  "compatibility_date": "2024-05-24",
  // Adds share tags (og:title/og:image) to public HTML pages and serves /sitemap.xml and /robots.txt.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker; JS, CSS and images go straight to the assets layer.
    "run_worker_first": ["/", "/courses", "/schedule", "/about", "/blog", "/blog/*", "/sitemap.xml", "/robots.txt", "/courses/*", "/p/*", "/manifest.webmanifest"]
  },
  "vars": {
    // Set per environment to the same value as VITE_API_BASE_URL (ends with /api).
    "API_BASE_URL": ""
  },
  // staging = Worker "netprime-frontend-staging": pnpm run deploy:frontend:staging (build ด้วย .env.staging)
  // vars ไม่สืบทอดข้าม env จึงต้องระบุใหม่; main และ assets สืบทอดจากด้านบน
  "env": {
    "staging": {
      "vars": {
        "API_BASE_URL": ""
      }
    }
  }
}
