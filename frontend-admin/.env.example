# Backend API URL (for local dev)
# VITE_API_BASE_URL=http://localhost:8787/api

# Backend API URL (for Cloudflare Production)
# Replace with your deployed worker URL:
VITE_API_BASE_URL=https://netprime-backend.<your-subdomain>.workers.dev/api

# Optional: Cloudflare Turnstile site key for public forms (pair with backend secret TURNSTILE_SECRET_KEY)
# VITE_TURNSTILE_SITE_KEY=
