# Workers static assets headers (copied to dist/ by Vite). The service worker must always be revalidated
# so updates are noticed; the manifest gets its registered media type.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
/offline.html
  Cache-Control: no-cache
/icons/*
  Cache-Control: public, max-age=604800
